<div class="miniapp-fab open" data-miniapp>
  <div class="miniapp-panel" id="miniapp-panel" aria-hidden="false">
    <button class="miniapp-close" type="button" aria-label="收起小程序码">×</button>
    <img class="miniapp-qr" src="<%= relative_path %>images/command-hub.png" alt="微信小程序码：扫码打开命令速查小程序" width="172" height="172" loading="lazy" decoding="async">
    <p class="miniapp-title">小程序版</p>
    <p class="miniapp-desc">微信扫码，随时查命令</p>
  </div>
  <button class="miniapp-toggle" type="button" aria-expanded="true" aria-controls="miniapp-panel" aria-label="展开或收起小程序码">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 3h8v8H3V3zm2 2v4h4V5H5zm8-2h8v8h-8V3zm2 2v4h4V5h-4zM3 13h8v8H3v-8zm2 2v4h4v-4H5zm9 0h2v2h-2v-2zm2 2h2v2h-2v-2zm2-2h2v2h-2v-2zm0 4h2v2h-2v-2zm-2 2h2v2h-2v-2zm-2-2h2v2h-2v-2z"/></svg>
    <span>小程序</span>
  </button>
</div>
<script src="<%= relative_path %>js/miniapp.js?v=<%= v %>" defer></script>
