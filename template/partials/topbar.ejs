<div class="header<% if (isHome) { %> home<% } else { %> header_list<% } %>">
  <div class="header_inner">
      <div class="logo">
          <a href="<%= relative_path %>index.html" title="命令搜索引擎">
            <%- logo %>
          </a>
      </div>
      <%- include('branch-tabs') %>
      <div class="search">
          <ul class="search-list" id="result">
            <!-- <li><a href="#"><strong>find</strong> - 指定目录下查找文件。</a></li> -->
          </ul>
          <input type="text" class="query" id="query" autocomplete="off" autofocus="autofocus" placeholder="<%= placeholder %>"/>
          <div class="enter-input">
              <input type="hidden" id="current_path" value="<%= current_path %>">
              <input type="hidden" id="root_prefix" value="<%= relative_path %>">
              <button id="search_btn">搜索</button>
          </div>
          <a class="github-link" href="<%= site.repo %>" target="_blank" rel="noopener" title="查看本站源码" aria-label="查看本站源码"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg></a>
      </div>
  </div>
</div>
