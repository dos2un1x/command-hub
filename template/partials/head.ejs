<%
const _title = (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : site.name;
const _desc = (typeof metaDescription !== 'undefined' && metaDescription) ? metaDescription : site.slogan;
const _keywords = (typeof metaKeywords !== 'undefined' && metaKeywords) ? metaKeywords : site.keywords;
const _canonical = (typeof canonicalUrl !== 'undefined' && canonicalUrl) ? canonicalUrl : '';
const _robots = (typeof robots !== 'undefined' && robots) ? robots : '';
const _ogType = (typeof ogType !== 'undefined' && ogType) ? ogType : 'website';
%>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge, chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content="<%= _desc %>">
    <meta name="keywords" content="<%= _keywords %>">
    <meta name="applicable-device" content="pc,mobile">
    <title><%= _title %></title>
<% if (_canonical) { %>    <link rel="canonical" href="<%= _canonical %>">
<% } %><% if (_robots) { %>    <meta name="robots" content="<%= _robots %>">
<% } %><% if (_canonical) { %>    <meta property="og:type" content="<%= _ogType %>">
    <meta property="og:title" content="<%= _title %>">
    <meta property="og:description" content="<%= _desc %>">
    <meta property="og:url" content="<%= _canonical %>">
    <meta property="og:site_name" content="<%= site.name %>">
    <meta property="og:locale" content="zh_CN">
<% } %>    <link rel="shortcut icon" href="<%= relative_path %>images/favicon.ico?v=<%= v %>">
    <link rel="stylesheet" type="text/css" href="<%= relative_path %>css/index.css?v=<%= v %>">
    <script src="<%= relative_path %>js/dark-mode.min.js"></script><% if (typeof extraCss !== 'undefined' && extraCss) { %><% extraCss.forEach(function (href) { %>
    <link rel="stylesheet" type="text/css" href="<%= href %>"><% }) %><% } %>
</head>
<body>
<dark-mode permanent dark="Dark" light="Light" style="position: fixed;left: 10px;top: 8px; z-index: 999;"></dark-mode>
