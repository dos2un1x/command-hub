<%- include('partials/head') %><%- include('partials/topbar') %>
<div class="hotlist">
  <h1 class="hotlist-title"><%= branchH1 %></h1>
  <p class="hotlist-desc"><%= branchIntro %></p>
<% if (typeof learningPath !== 'undefined' && learningPath) { %>
  <a class="branch-learning" href="../<%= learningPath.branch %>/<%= learningPath.slug %>.html">
    <span class="branch-learning-kicker">学习路径</span>
    <span class="branch-learning-body">
      <strong><%= learningPath.title %></strong>
      <span class="branch-learning-desc"><%= learningPath.desc %></span>
    </span>
    <span class="branch-learning-cta">按顺序开始 →</span>
  </a>
<% } %>
<% if (currentBranch === 'troubleshoot') { %>
  <a class="branch-learning" href="../diagnose.html">
    <span class="branch-learning-kicker">诊断向导</span>
    <span class="branch-learning-body">
      <strong>按现象逐步定位</strong>
      <span class="branch-learning-desc">6 棵决策树，每一步给出验证命令和对应条目</span>
    </span>
    <span class="branch-learning-cta">开始判断 →</span>
  </a>
<% } %>
<% if (typeof categoryNav !== 'undefined' && categoryNav.length) { %>
  <nav class="category-links" aria-label="<%= brand %> 分类">
  <% categoryNav.forEach(function (c) { %>
    <a class="category-chip" href="category/<%= c.id %>/"><%= c.name %><span><%= c.count %></span></a>
  <% }); %>
  </nav>
<% } %>
  <ul>
  <% items.forEach(function(page) { %>
    <li><a href="<%= page.n %>.html"><%= page.n %> - <%= page.d %></a></li>
  <% }); %>
  </ul>
</div>

<%- include('partials/sitefooter') %>
<%- include('partials/scripts') %>
