<%- include('partials/head') %><%- include('partials/topbar') %>
<script type="text/javascript" src="<%= relative_path %>js/copy-to-clipboard.js?v=<%= v %>"></script>

<div class="markdown-body">

<nav class="breadcrumb" aria-label="面包屑">
  <a href="<%= relative_path %>index.html">首页</a>
  <span class="sep">›</span>
  <a href="index.html"><%= brand %></a>
<% if (typeof category !== 'undefined' && category) { %>
  <span class="sep">›</span>
  <a href="category/<%= category.id %>/"><%= category.name %></a>
<% } %>
  <span class="sep">›</span>
  <span class="current"><%= typeof displayName !== 'undefined' && displayName ? displayName : describe.n %></span>
</nav>

<% if (learningLink) { %>
<a class="learning-link" href="<%= relative_path %><%= learningLink.p.replace(/^\//, '') %>.html">
  <span>系统学习</span>
  <strong><%= learningLink.d %></strong>
  <span aria-hidden="true">→</span>
</a>
<% } %>
<% if (verified) { %>
<p class="verified-badge">版本信息最后核对：<%= verified %></p>
<% } %>
<% if (labStatus) { %>
<p class="lab-status lab-status-<%= labStatus.status %>">Lab 状态：<strong><%= labStatus.label %></strong><span class="lab-status-meta"><%= labStatus.checked %> · <%= labStatus.environment %></span></p>
<% if (labStatus.note) { %><p class="lab-status-note"><%= labStatus.note %></p><% } %>
<% } %>

<%- mdhtml %>

<% if (troubleshootLinks && troubleshootLinks.length) { %>
<aside class="troubleshoot-links" aria-label="遇到问题">
  <h2>遇到问题?</h2>
  <ul>
  <% troubleshootLinks.forEach(function (link) { %>
    <li>
      <a href="<%= relative_path %><%= link.p.replace(/^\//, '') %>.html"><%= link.n %></a>
      <span><%= link.d %></span>
    </li>
  <% }); %>
  </ul>
</aside>
<% } %>

<% if (related && related.length) { %>
<nav class="related-commands" aria-label="相关命令">
  <h2>相关命令</h2>
  <ul class="related-grid">
  <% related.forEach(function (page) { %>
    <li class="related-card">
      <a class="related-card-link" href="<%= relative_path %><%= page.b %>/<%= page.n %>.html">
        <span class="related-name"><%= page.n %></span>
        <span class="related-branch"><%= page.bn || page.b %></span>
      </a>
      <p class="related-desc"><%= page.d %></p>
    </li>
  <% }); %>
  </ul>
</nav>
<% } %>
<% if (prevItem || nextItem) { %>
<nav class="prev-next" aria-label="上一条与下一条">
  <% if (prevItem) { %><a class="prev" href="<%= relative_path %><%= prevItem.b %>/<%= prevItem.n %>.html">← <%= prevItem.n %></a><% } %>
  <% if (nextItem) { %><a class="next" href="<%= relative_path %><%= nextItem.b %>/<%= nextItem.n %>.html"><%= nextItem.n %> →</a><% } %>
</nav>
<% } %>

</div>
<%- include('partials/sitefooter') %>
<%- include('partials/scripts') %>
