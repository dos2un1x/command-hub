<%- include('partials/head') %><div class="warpper home-page">
<%- include('partials/topbar') %>
<main class="home-intro">
  <p class="home-eyebrow"><span class="home-eyebrow-dot" aria-hidden="true"></span>面向运维与开发的八分支速查</p>
  <h1>从命令到排障，<span class="home-title-accent">一套速查</span></h1>
  <p class="home-lead">本站收录 <%= total %> 个条目，覆盖 Linux、Kubernetes、DevOps、故障排查、工具对比、中间件、迁移搭建教程与 AI/MLOps。先按目的选入口，再按分支深入；按命令查语法，按报错找原因，按场景做选择。</p>
  <ul class="home-stats" aria-label="站点内容统计">
    <li><strong><%= total %></strong><span>条目</span></li>
    <li><strong><%= branchCount %></strong><span>分支</span></li>
    <li><strong><%= categoryCount %></strong><span>分类</span></li>
  </ul>
  <nav class="home-games" aria-label="站内小游戏">
    <span class="home-games-label">小彩蛋</span>
    <a href="snake.html">🎮 贪吃蛇</a>
    <a href="tetris.html">🧱 俄罗斯方块</a>
  </nav>
  <section class="home-scenarios" aria-labelledby="scenarios-title">
    <div class="home-section-head">
      <h2 id="scenarios-title">我想…</h2>
      <span class="home-branch-note">按目的进入 · <a class="home-more" href="review.html">每日复习 →</a></span>
    </div>
    <ul class="home-scenario-grid">
      <li class="home-scenario-card">
        <a href="hot.html">
          <span class="home-scenario-kicker">查</span>
          <span class="home-scenario-title">查一个命令</span>
          <span class="home-scenario-desc">按名字、报错或工具直接定位</span>
        </a>
      </li>
      <li class="home-scenario-card">
        <a href="guide/learning-paths.html">
          <span class="home-scenario-kicker">学</span>
          <span class="home-scenario-title">学一个领域</span>
          <span class="home-scenario-desc">十条学习路径：从心智模型到动手任务</span>
        </a>
      </li>
      <li class="home-scenario-card">
        <a href="troubleshoot/">
          <span class="home-scenario-kicker">排</span>
          <span class="home-scenario-title">排一个故障</span>
          <span class="home-scenario-desc">按现象、根因、修复组织</span>
        </a>
      </li>
      <li class="home-scenario-card">
        <a href="tutorial/">
          <span class="home-scenario-kicker">做</span>
          <span class="home-scenario-title">上线一个服务</span>
          <span class="home-scenario-desc">迁移、搭建与升级的完整步骤</span>
        </a>
      </li>
      <li class="home-scenario-card">
        <a href="diagnose.html">
          <span class="home-scenario-kicker">诊</span>
          <span class="home-scenario-title">跟着向导查</span>
          <span class="home-scenario-desc">六棵决策树：下一步该看什么</span>
        </a>
      </li>
    </ul>
  </section>
  <section class="home-branches" aria-labelledby="branches-title">
    <div class="home-section-head">
      <h2 id="branches-title">八分支入口</h2>
      <span class="home-branch-note">按问题类型进入</span>
    </div>
    <ul class="home-branch-grid">
    <% branchCards.forEach(function (b) { %>
      <li class="home-branch-card">
        <a href="<%= b.id %>/">
          <span class="home-branch-name"><%= b.name %></span>
          <span class="home-branch-desc"><%= b.desc %></span>
          <span class="home-branch-meta"><%= b.count %> 个条目 · <%= b.categoryCount %> 个分类</span>
        </a>
      </li>
    <% }); %>
    </ul>
  </section>
  <section class="home-hot" aria-labelledby="hot-title">
    <div class="home-section-head">
      <h2 id="hot-title">高频入口</h2>
      <a class="home-more" href="hot.html">全部条目 →</a>
    </div>
    <ul class="hot-commands">
    <% hotCommands.forEach(function (page) { %>
      <li><a href="<%= page.b %>/<%= page.n %>.html"><%= page.n %></a></li>
    <% }); %>
    </ul>
  </section>
</main>
<%- include('partials/sitefooter') %>
</div>
<%- include('partials/scripts') %>
