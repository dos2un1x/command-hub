node_modules/
build/
.DS_Store

# 部署暂存:build/ 的副本与其打包产物,由 npm run package 生成
/public/
/public.zip

# 部署状态、日志与本地 nginx 备份,不对外发布
/deploy/

# 百度推送 token,只保存在本机
/.baidu-token

# 访问统计的本地 SQLite(线上数据库在 webroot 外)
/server/data/
# 访问统计的数据库密码,只保存在服务器上
/server/config.php

# 本机每日定时推送脚本(含站点配置),不对外发布
/scripts/baidu-daily.sh

# 本机工作记录(AI 辅助设计文档),不对外发布
/docs/

# 浏览器自动化测试的临时产物(截图、console 日志),不对外发布
/.playwright-mcp/
/.superpowers/
